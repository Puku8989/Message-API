# ──────────────────────────────────────────────
# Telegram Bot API
# ──────────────────────────────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The chat ID to send messages to (user, group, or channel)
# Use @userinfobot or the getUpdates API to find this
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ──────────────────────────────────────────────
# Telegram Client API (Telethon) — for phone-number messaging
# ──────────────────────────────────────────────
# Obtain from https://my.telegram.org → API development tools
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Your own Telegram phone number (used to authenticate the session)
TELEGRAM_PHONE=your_phone_number_here

# ──────────────────────────────────────────────
# Application Settings (optional)
# ──────────────────────────────────────────────
# API request timeout in seconds (default: 30)
# API_TIMEOUT=30

# Maximum retry attempts for failed requests (default: 3)
# MAX_RETRIES=3

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO
